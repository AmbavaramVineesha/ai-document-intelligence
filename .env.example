# Document Intelligence & Extraction Platform Configuration

# Database Persistence
DATABASE_URL=sqlite:///./document_intelligence.db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Frontend URL for CORS (set to your deployed Vercel/Netlify frontend URL)
# Example: FRONTEND_URL=https://docintel.vercel.app
FRONTEND_URL=

# Optional External AI / OCR Service API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
OCR_SPACE_API_KEY=

# Financial Reconciliation Settings
FINANCIAL_TOLERANCE_PERCENT=0.02
FINANCIAL_TOLERANCE_ABSOLUTE=1.00
